{
  "comment": "Protocol major 1 / minor 2 OPEN admission cases (AniSub runtime). env = what the runtime has; message = OPEN fields beyond the session envelope; expect = the decision. Shared by the Android JVM tests (ProtocolMinor2Test) and the Node contract test. Error detail keys are added to the ERROR reply next to type/major/code/session/revision.",
  "cases": [
    {"name": "minor1-ai-vi-no-voiceLang", "env": {"packs": ["vi"]}, "language": "vi", "message": {"mode": "ai"},
     "expect": {"mode": "ai", "voiceLang": "vi", "translate": false}},
    {"name": "minor1-system-test", "env": {"system": true}, "language": "vi", "message": {"systemTest": true},
     "expect": {"mode": "system", "voiceLang": "vi", "translate": false}},
    {"name": "minor1-ai-pack-missing", "env": {}, "language": "vi", "message": {"mode": "ai"},
     "expect": {"error": "VOICE_PACK_MISSING", "detail": {"voiceLang": "vi"}}},
    {"name": "vi-softsub-en-voice-needs-en-pack", "env": {"packs": ["vi"], "translate": true, "models": ["vi"]}, "language": "vi", "message": {"mode": "ai", "voiceLang": "en"},
     "expect": {"error": "VOICE_PACK_MISSING", "detail": {"voiceLang": "en"}}},
    {"name": "en-softsub-vi-voice-translates", "env": {"packs": ["vi"], "translate": true, "models": ["vi"]}, "language": "en", "message": {"mode": "ai", "voiceLang": "vi"},
     "expect": {"mode": "ai", "voiceLang": "vi", "translate": true, "source": "en"}},
    {"name": "en-softsub-en-voice-no-translation", "env": {"packs": ["en"]}, "language": "en-US", "message": {"mode": "ai", "voiceLang": "en"},
     "expect": {"mode": "ai", "voiceLang": "en", "translate": false, "source": "en"}},
    {"name": "ja-softsub-vi-voice-needs-ja-and-vi", "env": {"packs": ["vi"], "translate": true, "models": []}, "language": "ja", "message": {"mode": "ai"},
     "expect": {"error": "TRANSLATE_MODEL_MISSING", "detail": {"language": "ja", "from": "ja", "to": "vi", "voiceLang": "vi", "missing": ["ja", "vi"]}}},
    {"name": "ja-softsub-vi-voice-ready", "env": {"packs": ["vi"], "translate": true, "models": ["ja", "vi"]}, "language": "ja", "message": {"mode": "ai"},
     "expect": {"mode": "ai", "voiceLang": "vi", "translate": true, "source": "ja"}},
    {"name": "ja-softsub-en-voice-needs-ja", "env": {"packs": ["en"], "translate": true, "models": ["vi"]}, "language": "ja", "message": {"mode": "ai", "voiceLang": "en"},
     "expect": {"error": "TRANSLATE_MODEL_MISSING", "detail": {"language": "ja", "from": "ja", "to": "en", "voiceLang": "en", "missing": ["ja"]}}},
    {"name": "vi-softsub-en-voice-needs-vi-model", "env": {"packs": ["vi", "en"], "translate": true, "models": []}, "language": "vi", "message": {"mode": "ai", "voiceLang": "en"},
     "expect": {"error": "TRANSLATE_MODEL_MISSING", "detail": {"language": "vi", "from": "vi", "to": "en", "voiceLang": "en", "missing": ["vi"]}}},
    {"name": "no-engine", "env": {"packs": ["vi"], "translate": false, "reason": "NO_DOWNLOAD_MANAGER"}, "language": "en", "message": {"mode": "ai"},
     "expect": {"error": "TRANSLATE_UNAVAILABLE", "detail": {"voiceLang": "vi", "reason": "NO_DOWNLOAD_MANAGER", "language": "en"}}},
    {"name": "unsupported-source-language", "env": {"packs": ["vi"], "translate": true, "models": ["vi"]}, "language": "yi", "message": {"mode": "ai"},
     "expect": {"error": "TRANSLATE_UNAVAILABLE", "detail": {"voiceLang": "vi", "language": "yi", "reason": "UNSUPPORTED_LANGUAGE"}}},
    {"name": "und-detected-later", "env": {"packs": ["vi"], "translate": true, "models": ["vi"], "detect": true}, "language": "und", "message": {"mode": "ai"},
     "expect": {"mode": "ai", "voiceLang": "vi", "translate": true, "source": "und"}},
    {"name": "und-without-detection-is-english", "env": {"packs": ["en"], "translate": true, "models": []}, "language": "und", "message": {"mode": "ai", "voiceLang": "en"},
     "expect": {"mode": "ai", "voiceLang": "en", "translate": false, "source": "en"}},
    {"name": "und-needs-target-model", "env": {"packs": ["vi"], "translate": true, "models": [], "detect": true}, "language": "und", "message": {"mode": "ai"},
     "expect": {"error": "TRANSLATE_MODEL_MISSING", "detail": {"language": "vi", "from": "und", "to": "vi", "missing": ["vi"]}}},
    {"name": "unknown-voiceLang", "env": {"packs": ["vi"]}, "language": "vi", "message": {"mode": "ai", "voiceLang": "fr"},
     "expect": {"error": "UNSUPPORTED", "detail": {"voiceLang": "fr"}}},
    {"name": "voiceLang-wrong-type", "env": {"packs": ["vi"]}, "language": "vi", "message": {"mode": "ai", "voiceLang": 1},
     "expect": {"error": "MALFORMED"}},
    {"name": "system-mode-stays-vietnamese", "env": {"system": true, "packs": ["en"]}, "language": "vi", "message": {"systemTest": true, "voiceLang": "en"},
     "expect": {"error": "UNSUPPORTED"}},
    {"name": "voice-from-other-pack-rejected", "env": {"packs": ["vi", "en"]}, "language": "en", "message": {"mode": "ai", "voiceLang": "en", "voice": "vais1000"},
     "expect": {"error": "UNSUPPORTED"}}
  ]
}
