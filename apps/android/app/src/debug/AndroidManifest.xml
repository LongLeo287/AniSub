<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- DEBUG BUILDS ONLY: emulator test harness (ANISUB-004). Not present in release builds.
         Guarded by android.permission.DUMP: only the adb shell / system hold it (apps cannot get it),
         so no other app on the device can start the harness. -->
    <application>
        <activity android:name=".DebugHarnessActivity" android:exported="true" android:launchMode="singleTop"
            android:permission="android.permission.DUMP" tools:ignore="ExportedActivity,ProtectedPermissions" />
    </application>
</manifest>
