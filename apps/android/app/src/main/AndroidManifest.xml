<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Owner approved 08-10-2026: DownloadProvider requires INTERNET on the calling UID too.
         Keep DownloadManager transport, pinned integrity and disabled usage-log discovery below.
         This permission also enables dependency network clients; it is not a per-host firewall. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice-pack downloads run hidden in the download provider's cache (copied, verified, removed). -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />
    <!-- Kept defined for compatibility, but NOT required by the service or activity: AniBox is
         usually installed before AniSub, so it could never be granted. Callers are verified at
         runtime by UID, exact package com.anibox.tv and same signing certificate. -->
    <permission android:name="com.anisub.runtime.BIND" android:protectionLevel="signature" />
    <queries><package android:name="com.anibox.tv" /><intent><action android:name="android.intent.action.TTS_SERVICE" /></intent></queries>
    <application android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:label="AniSub" android:icon="@drawable/ic_anisub"
        android:banner="@drawable/banner" android:supportsRtl="true" android:usesCleartextTraffic="false" tools:ignore="DataExtractionRules"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.anisub.runtime.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Intentionally no android:permission (see the install-order note above). Every message is
             authorized in AniSubService before its Bundle is read. -->
        <service android:name=".AniSubService" android:exported="true" tools:ignore="ExportedService" />

        <!-- ANISUB-004 (ML Kit Translate + language-id): no usage telemetry. Without its backend discovery
             service Firebase datatransport has no "cct" (Clearcut) backend to upload ML Kit's usage logs to;
             its scheduler service/receiver stay (the runtime expects them; with no backend they send nothing).
             Same approach as AniBox LOGO-004. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />
        <!-- Nothing of ML Kit at process start: MlKitTranslation initialises it on first use. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />
        <!-- AppCompat (brought by ML Kit) registers EmojiCompat's start-up initialiser (a font load at
             start); AniSub uses no AppCompat widgets. Only that initialiser goes. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
