{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:anisub:android:2:messages",
  "title":"Android major 2.0 requests and replies (draft, flat wire envelope)",
  "$comment":"Internal typed bodies are never JSON body keys. UTF-16 limits, known end >= start, unique cue IDs, transferred<=expected bytes, readiness flag coherence and sequence/admission rules require semantic validation. Production JSON/Bundle codec remains Task 6.",
  "oneOf":[{"$ref":"#/$defs/request"},{"$ref":"#/$defs/reply"}],
  "$defs":{
  "request":{
  "type":"object","required":["major","type","requestId"],
  "properties":{
    "major":{"const":2},"type":{"enum":["HELLO","GET_CAPABILITIES","GET_SETTINGS","SET_SETTINGS","LIST_MODELS","LIST_VOICES","DOWNLOAD_MODEL","CANCEL_DOWNLOAD","REMOVE_MODEL","PREPARE_MODEL","OPEN","CUE_SNAPSHOT","TIMELINE_BATCH","CLOCK_ANCHOR","PLAY","PAUSE","SEEK","STOP","PLAYBACK_SPEED","EPISODE_CHANGE","SOURCE_CHANGE","CLOSE"]},
    "requestId":{"$ref":"#/$defs/id"},"sessionId":{"$ref":"#/$defs/id"},"revision":{"$ref":"#/$defs/safe"},"seq":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "minor":{"const":0},"expectedSettingsRevision":{"$ref":"#/$defs/safe"},"settings":{"$ref":"#/$defs/settings"},
    "pageToken":{"$ref":"#/$defs/nullableId"},"pageSize":{"type":"integer","minimum":1,"maximum":16},
    "modelId":{"$ref":"#/$defs/id"},"version":{"$ref":"#/$defs/id"},"consent":{"const":true},"operationId":{"$ref":"#/$defs/id"},
    "episodeRef":{"$ref":"#/$defs/ref"},"sourceRef":{"$ref":"#/$defs/ref"},"trackRef":{"$ref":"#/$defs/ref"},
    "inputMode":{"const":"DIRECT_TEXT"},"trackAvailability":{"const":"TEXT_TRACK"},"originalLanguage":{"const":"vi"},"targetLanguage":{"const":"vi"},
    "settingsRevision":{"$ref":"#/$defs/safe"},"voiceId":{"$ref":"#/$defs/id"},"speechEnabled":{"type":"boolean"},"clock":{"$ref":"#/$defs/clock"},
    "cues":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/cue"}}
  },
  "additionalProperties":true,
  "allOf":[
    {"if":{"properties":{"type":{"const":"HELLO"}}},"then":{"required":["minor"]}},
    {"if":{"properties":{"type":{"const":"SET_SETTINGS"}}},"then":{"required":["expectedSettingsRevision","settings"]}},
    {"if":{"properties":{"type":{"enum":["LIST_VOICES","DOWNLOAD_MODEL","REMOVE_MODEL","PREPARE_MODEL"]}}},"then":{"required":["modelId","version"]}},
    {"if":{"properties":{"type":{"const":"DOWNLOAD_MODEL"}}},"then":{"required":["consent"]}},
    {"if":{"properties":{"type":{"const":"CANCEL_DOWNLOAD"}}},"then":{"required":["operationId"]}},
    {"if":{"properties":{"type":{"enum":["OPEN","CUE_SNAPSHOT","TIMELINE_BATCH","CLOCK_ANCHOR","PLAY","PAUSE","SEEK","STOP","PLAYBACK_SPEED","EPISODE_CHANGE","SOURCE_CHANGE","CLOSE"]}}},"then":{"required":["sessionId","revision","seq"]}},
    {"if":{"properties":{"type":{"const":"OPEN"}}},"then":{"required":["episodeRef","sourceRef","trackRef","inputMode","trackAvailability","originalLanguage","targetLanguage","settingsRevision","modelId","version","voiceId","speechEnabled","clock"]}},
    {"if":{"properties":{"type":{"enum":["CLOCK_ANCHOR","PLAY","PAUSE","SEEK","STOP","PLAYBACK_SPEED"]}}},"then":{"required":["clock"]}},
    {"if":{"properties":{"type":{"enum":["CUE_SNAPSHOT","TIMELINE_BATCH"]}}},"then":{"required":["cues"]}},
    {"if":{"properties":{"type":{"const":"TIMELINE_BATCH"}}},"then":{"properties":{"cues":{"items":{"allOf":[{"$ref":"#/$defs/cue"},{"properties":{"startMs":{"$ref":"#/$defs/safe"},"endMs":{"$ref":"#/$defs/safe"}}}]}}}}}
  ]
  },
    "id":{"type":"string","minLength":1,"maxLength":80,"x-maxUtf16Units":80},
    "ref":{"allOf":[{"$ref":"#/$defs/id"},{"not":{"pattern":"^[A-Za-z][A-Za-z0-9+.-]*:"}},{"not":{"pattern":"\\\\"}}]},
    "nullableId":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
    "safe":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "nullableTime":{"anyOf":[{"$ref":"#/$defs/safe"},{"type":"null"}]},
    "clock":{"type":"object","required":["positionMs","sampledAtElapsedMs","playing","speed"],"properties":{"positionMs":{"$ref":"#/$defs/safe"},"sampledAtElapsedMs":{"$ref":"#/$defs/safe"},"playing":{"type":"boolean"},"speed":{"type":"number","minimum":0.5,"maximum":2}},"additionalProperties":true},
    "cue":{"type":"object","required":["cueId","originalText","language","observedAtMediaMs","startMs","endMs","origin","role","trackRef"],"properties":{"cueId":{"$ref":"#/$defs/id"},"originalText":{"type":"string","maxLength":512,"x-maxUtf16Units":512},"language":{"const":"vi"},"observedAtMediaMs":{"$ref":"#/$defs/safe"},"startMs":{"$ref":"#/$defs/nullableTime"},"endMs":{"$ref":"#/$defs/nullableTime"},"origin":{"const":"DIRECT"},"role":{"enum":["DIALOGUE","ANNOTATION","UNKNOWN"]},"trackRef":{"$ref":"#/$defs/ref"}},"additionalProperties":true},
    "settings":{"type":"object","required":["voiceMode","modelId","modelVersion","voiceId","targetLanguage","rateMode","deliveryMode"],"properties":{"voiceMode":{"enum":["AUTO","EXPLICIT"]},"modelId":{"$ref":"#/$defs/nullableId"},"modelVersion":{"$ref":"#/$defs/nullableId"},"voiceId":{"$ref":"#/$defs/nullableId"},"targetLanguage":{"const":"vi"},"rateMode":{"enum":["AUTO","NATURAL"]},"deliveryMode":{"const":"LIVE_BOUNDED"}},"if":{"properties":{"voiceMode":{"const":"EXPLICIT"}}},"then":{"properties":{"modelId":{"$ref":"#/$defs/id"},"modelVersion":{"$ref":"#/$defs/id"},"voiceId":{"$ref":"#/$defs/id"}}},"additionalProperties":true},
    "errorCode":{"enum":["PROTOCOL_MISMATCH","UNAUTHORIZED","MALFORMED","UNSUPPORTED","UNSUPPORTED_TRANSLATION","UNAVAILABLE","MODEL_MISSING","MODEL_CORRUPT","MODEL_INCOMPATIBLE","MODEL_IN_USE","SETTINGS_CONFLICT","STALE","CLOCK_STALE","EXPIRED","OUTSIDE_HORIZON","BACKPRESSURE","PROVIDER_FAILED","TIMEOUT","DISCONNECTED","CANCELLED"]},
    "modelStatus":{"enum":["NOT_INSTALLED","DOWNLOADING","VERIFYING","INSTALLED","PREPARING","READY","ERROR","INCOMPATIBLE"]},
    "modelEntry":{"type":"object","required":["modelId","version","state"],"properties":{"modelId":{"$ref":"#/$defs/id"},"version":{"$ref":"#/$defs/id"},"state":{"$ref":"#/$defs/modelStatus"}},"additionalProperties":true},
    "catalogEntry":{"allOf":[{"$ref":"#/$defs/modelEntry"},{"type":"object","required":["downloadBytes","expandedBytes","licenseRef","task","languages","compatible"],"properties":{"downloadBytes":{"type":"integer","minimum":1,"maximum":9007199254740991},"expandedBytes":{"type":"integer","minimum":1,"maximum":9007199254740991},"licenseRef":{"$ref":"#/$defs/id"},"task":{"const":"TTS"},"languages":{"type":"array","minItems":1,"maxItems":16,"items":{"const":"vi"}},"compatible":{"type":"boolean"}}}]},
    "voice":{"type":"object","required":["id","modelId","version","language","displayName","accent","gender","verifiedMetadata","supportedRateModes","outputMode"],"properties":{"id":{"$ref":"#/$defs/id"},"modelId":{"$ref":"#/$defs/id"},"version":{"$ref":"#/$defs/id"},"language":{"const":"vi"},"displayName":{"type":"string","minLength":1,"maxLength":512,"x-maxUtf16Units":512},"accent":{"enum":["UNKNOWN","NORTH","CENTRAL","SOUTH"]},"gender":{"enum":["UNKNOWN","MALE","FEMALE"]},"verifiedMetadata":{"type":"boolean"},"supportedRateModes":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"enum":["NATURAL","AUTO"]}},"outputMode":{"enum":["FULL_UTTERANCE","STREAMING_PCM"]}},"if":{"properties":{"verifiedMetadata":{"const":false}}},"then":{"properties":{"accent":{"const":"UNKNOWN"},"gender":{"const":"UNKNOWN"}}},"additionalProperties":true},
    "limits":{"type":"object","required":["maxPayloadUtf16Units","maxBundleBytes","maxCues","maxTextUtf16Units","maxIdUtf16Units","maxPageSize","maxInstalledVersions","maxReadyModels"],"properties":{"maxPayloadUtf16Units":{"const":16384},"maxBundleBytes":{"const":65536},"maxCues":{"const":16},"maxTextUtf16Units":{"const":512},"maxIdUtf16Units":{"const":80},"maxPageSize":{"const":16},"maxInstalledVersions":{"const":64},"maxReadyModels":{"const":1}},"additionalProperties":true},
    "reply":{
      "type":"object","required":["major","type"],"additionalProperties":true,
      "properties":{
        "major":{"const":2},"type":{"enum":["ACK","ERROR","HELLO_ACK","CAPABILITIES","SETTINGS","MODELS","VOICES","MODEL_PROGRESS","MODEL_STATE","SPEECH_STARTED","SPEECH_FINISHED","REJECTED_CUE"]},
        "requestId":{"$ref":"#/$defs/id"},"sessionId":{"$ref":"#/$defs/id"},"revision":{"$ref":"#/$defs/safe"},"eventSeq":{"type":"integer","minimum":1,"maximum":9007199254740991},"operationId":{"$ref":"#/$defs/id"},"speechId":{"$ref":"#/$defs/id"},"cueId":{"$ref":"#/$defs/id"},"segmentIndex":{"type":"integer","minimum":0,"maximum":2147483647},"modelVersion":{"$ref":"#/$defs/id"},
        "code":{"$ref":"#/$defs/errorCode"},"recoverable":{"type":"boolean"},"minor":{"const":0},"limits":{"$ref":"#/$defs/limits"},"settingsRevision":{"$ref":"#/$defs/safe"},"settings":{"$ref":"#/$defs/settings"},
        "models":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/catalogEntry"}},"voices":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/voice"}},"nextPageToken":{"$ref":"#/$defs/nullableId"},
        "bytesTransferred":{"$ref":"#/$defs/safe"},"expectedBytes":{"$ref":"#/$defs/safe"},"modelId":{"$ref":"#/$defs/id"},"version":{"$ref":"#/$defs/id"},
        "reason":{"anyOf":[{"$ref":"#/$defs/errorCode"},{"enum":["COMPLETED","FAILED"]},{"type":"null"}]},
        "protocolMajor":{"const":2},"state":{"type":"string"},"supportedInputs":{"type":"array","maxItems":16,"items":{"const":"DIRECT_TEXT"}},"translationPairs":{"type":"array","maxItems":0},"speechLanguages":{"type":"array","maxItems":16,"items":{"const":"vi"}},"aiVoice":{"type":"boolean"},"offline":{"type":"boolean"},"multiSpeaker":{"const":false},"lookahead":{"type":"boolean"},"clientHoldSupported":{"const":false},"engine":{"$ref":"#/$defs/id"},"installedModels":{"type":"array","maxItems":64,"items":{"allOf":[{"$ref":"#/$defs/modelEntry"},{"properties":{"state":{"enum":["INSTALLED","PREPARING","READY"]}}}]},"contains":{"properties":{"state":{"const":"READY"}}},"minContains":0,"maxContains":1}
      },
      "allOf":[
        {"if":{"properties":{"type":{"enum":["ACK","HELLO_ACK","SETTINGS","MODELS","VOICES"]}}},"then":{"required":["requestId"]}},
        {"if":{"properties":{"type":{"const":"HELLO_ACK"}}},"then":{"required":["minor","limits"]}},
        {"if":{"properties":{"type":{"const":"SETTINGS"}}},"then":{"required":["settingsRevision","settings"]}},
        {"if":{"properties":{"type":{"const":"ERROR"}}},"then":{"required":["code","recoverable"],"if":{"properties":{"code":{"const":"SETTINGS_CONFLICT"}},"required":["code"]},"then":{"required":["requestId","settingsRevision","settings"]}}},
        {"if":{"properties":{"type":{"const":"MODELS"}}},"then":{"required":["models","nextPageToken"]}},
        {"if":{"properties":{"type":{"const":"VOICES"}}},"then":{"required":["voices","nextPageToken"]}},
        {"if":{"properties":{"type":{"const":"MODEL_PROGRESS"}}},"then":{"required":["operationId","bytesTransferred","expectedBytes"]}},
        {"if":{"properties":{"type":{"const":"MODEL_STATE"}}},"then":{"required":["modelId","version","state"],"properties":{"state":{"$ref":"#/$defs/modelStatus"}},"if":{"properties":{"state":{"const":"ERROR"}},"required":["state"]},"then":{"required":["reason"],"properties":{"reason":{"$ref":"#/$defs/errorCode"}}}}},
        {"if":{"properties":{"type":{"const":"CAPABILITIES"}}},"then":{"required":["protocolMajor","minor","state","limits","supportedInputs","translationPairs","speechLanguages","aiVoice","offline","multiSpeaker","lookahead","clientHoldSupported","engine","installedModels"],"properties":{"state":{"enum":["INITIALIZING","MODEL_MISSING","INSTALLED","PREPARING","READY","UNAVAILABLE","ERROR"]}},"if":{"properties":{"state":{"const":"READY"}}},"then":{"properties":{"installedModels":{"contains":{"properties":{"state":{"const":"READY"}}},"minContains":1,"maxContains":1}}},"else":{"properties":{"installedModels":{"contains":{"properties":{"state":{"const":"READY"}}},"minContains":0,"maxContains":0},"aiVoice":{"const":false},"offline":{"const":false}}}}},
        {"if":{"properties":{"type":{"enum":["SPEECH_STARTED","SPEECH_FINISHED","REJECTED_CUE"]}}},"then":{"required":["sessionId","revision","eventSeq","cueId"]}},
        {"if":{"properties":{"type":{"enum":["SPEECH_STARTED","SPEECH_FINISHED"]}}},"then":{"required":["speechId","segmentIndex","modelVersion"]}},
        {"if":{"properties":{"type":{"const":"SPEECH_FINISHED"}}},"then":{"required":["reason"],"properties":{"reason":{"enum":["COMPLETED","CANCELLED","FAILED"]}}}},
        {"if":{"properties":{"type":{"const":"REJECTED_CUE"}}},"then":{"required":["reason"],"properties":{"reason":{"$ref":"#/$defs/errorCode"}}}}
      ]
    }
  }
}
