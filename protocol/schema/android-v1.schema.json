{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anisub:android:1:messages",
  "title": "Android Messenger protocol major 1, minor 2 (shipping contract; additive over minor 1)",
  "$comment": "Messenger what=1, Bundle string 'payload' (<=16,384 UTF-16 units). Covers the minor-2 additions and the fields they touch; minor-0/1 fields are documented in docs/android-addon-contract.md. Unknown optional keys are ignored. Semantic rules (sequence, revision, timing, cue-id uniqueness) are enforced by the runtime, not this schema.",
  "$defs": {
    "tag": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8}){0,7}$", "maxLength": 35 },
    "voiceLang": { "type": "string", "enum": ["vi", "en"] },
    "state": { "type": "string", "enum": ["ready", "missing", "downloading"] },
    "voiceEntry": {
      "type": "object",
      "required": ["state", "voices"],
      "properties": {
        "state": { "$ref": "#/$defs/state" },
        "id": { "type": "string" }, "version": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 }, "doneBytes": { "type": "integer", "minimum": 0 },
        "error": { "type": "string", "enum": ["NO_SPACE", "NETWORK", "CORRUPT", "INCOMPATIBLE", "STORAGE", "IN_USE"] },
        "voices": { "type": "array", "items": { "type": "object", "required": ["id", "name"] } }
      }
    },
    "cue": {
      "type": "object",
      "required": ["id", "text", "startMs", "endMs", "role"],
      "properties": {
        "id": { "type": "string", "maxLength": 80 }, "text": { "type": "string", "maxLength": 512 },
        "startMs": { "type": "integer", "minimum": 0 }, "endMs": { "type": "integer", "minimum": -1 },
        "role": { "type": "string", "enum": ["dialogue", "annotation", "unknown"] }
      }
    },
    "session": {
      "type": "object",
      "required": ["type", "major", "session", "revision", "seq", "positionMs", "speed", "language"],
      "properties": {
        "major": { "const": 1 }, "session": { "type": "string" }, "revision": { "type": "integer", "minimum": 0 },
        "seq": { "type": "integer", "minimum": 0 }, "positionMs": { "type": "integer", "minimum": 0 },
        "speed": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "language": { "$ref": "#/$defs/tag", "$comment": "minor 2: the CUE SOURCE language (BCP-47) or und; mode system stays vi" }
      }
    },
    "open": {
      "allOf": [{ "$ref": "#/$defs/session" }],
      "type": "object",
      "properties": {
        "type": { "const": "OPEN" },
        "mode": { "type": "string", "enum": ["system", "ai"] },
        "systemTest": { "type": "boolean" },
        "rate": { "type": "number", "minimum": 0.8, "maximum": 1.3 },
        "voice": { "type": "string", "maxLength": 80 },
        "voiceLang": { "$ref": "#/$defs/voiceLang", "$comment": "minor 2; absent = vi (every minor-1 client)" },
        "playing": { "type": "boolean" }
      }
    },
    "cues": {
      "allOf": [{ "$ref": "#/$defs/session" }],
      "type": "object",
      "required": ["cues"],
      "properties": {
        "type": { "const": "CUES" },
        "timeline": { "type": "boolean", "$comment": "minor 2: a batch of a whole subtitle file sent ahead; never clears; past cues skipped silently" },
        "cues": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/cue" } }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["type", "major", "minor", "protocolMajor", "directText", "tts", "offline", "aiVoice", "translation", "multiSpeaker",
        "engine", "state", "voicePack", "voices", "translate", "timeline", "aiEngine", "modes", "rate", "runtime"],
      "properties": {
        "type": { "const": "CAPABILITIES" }, "major": { "const": 1 }, "minor": { "const": 2 }, "protocolMajor": { "const": 1 },
        "voices": {
          "type": "object", "required": ["vi", "en"],
          "properties": { "vi": { "$ref": "#/$defs/voiceEntry" }, "en": { "$ref": "#/$defs/voiceEntry" } }
        },
        "translate": {
          "type": "object", "required": ["engine", "available", "models"],
          "properties": {
            "engine": { "const": "mlkit" }, "available": { "type": "boolean" }, "detect": { "type": "boolean" },
            "reason": { "type": "string", "enum": ["NO_DOWNLOAD_MANAGER", "NATIVE_UNAVAILABLE", "NO_ENGINE"] },
            "lookaheadMs": { "type": "integer", "minimum": 0 },
            "models": { "type": "object", "additionalProperties": { "$ref": "#/$defs/state" } }
          }
        },
        "timeline": {
          "type": "object", "required": ["maxCues", "maxTextUnits"],
          "properties": { "maxCues": { "type": "integer" }, "maxTextUnits": { "type": "integer" } }
        },
        "modes": { "type": "array", "items": { "type": "string", "enum": ["system", "ai"] } }
      }
    },
    "error": {
      "type": "object",
      "required": ["type", "major", "code"],
      "properties": {
        "type": { "const": "ERROR" }, "major": { "const": 1 },
        "code": { "type": "string", "enum": ["MALFORMED", "STALE", "UNSUPPORTED", "UNAVAILABLE", "VOICE_PACK_MISSING",
          "TRANSLATE_MODEL_MISSING", "TRANSLATE_UNAVAILABLE", "EXPIRED", "BACKPRESSURE", "OUTSIDE_HORIZON", "PROVIDER_FAILED", "TIMEOUT"] },
        "session": { "type": "string" }, "revision": { "type": "integer" }, "cueId": { "type": "string" },
        "voiceLang": { "type": "string" }, "language": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" },
        "missing": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string", "enum": ["NO_DOWNLOAD_MANAGER", "NATIVE_UNAVAILABLE", "NO_ENGINE", "UNSUPPORTED_LANGUAGE", "UNAVAILABLE"] }
      }
    },
    "languageDetected": {
      "type": "object",
      "required": ["type", "major", "session", "revision", "language", "assumed"],
      "properties": {
        "type": { "const": "LANGUAGE_DETECTED" }, "major": { "const": 1 }, "session": { "type": "string" },
        "revision": { "type": "integer" }, "language": { "type": "string" }, "assumed": { "type": "boolean" }
      }
    }
  }
}
